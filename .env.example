# ==============================================================================
# Auto-Heal Sandbox Agent - Environment Configuration Example
# Copy this file to '.env' and customize values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Settings
# Supported providers: 'gemini' (recommended) or 'openai' (local llama.cpp / vLLM)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_LLM_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Local OpenAI-Compatible LLM Fallback (e.g., llama.cpp, vLLM, Ollama)
# ------------------------------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:5813/v1
LLM_MODEL_NAME=gemini-3.5-flash-lite
LLM_API_KEY=local
LLM_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# 3. Docker Sandbox Isolation & Security Parameters
# ------------------------------------------------------------------------------
SANDBOX_IMAGE=auto-heal-sandbox:latest
SANDBOX_FALLBACK_IMAGE=python:3.11-slim
SANDBOX_MEM_LIMIT=512m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_NETWORK_MODE=none
SANDBOX_USER=nobody
SANDBOX_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 4. Agent Cyclic Execution Constraints
# ------------------------------------------------------------------------------
MAX_RETRIES=4
TRACEBACK_MAX_LINES=10
